&venus {
	firmware-name = "qcom/sm7150/xiaomi/surya/venus.mbn";
};

&vreg_l18a_2p8 {
	regulator-min-microvolt = <1696000>;
	regulator-max-microvolt = <1904000>;
};

&wifi {
	qcom,ath10k-calibration-variant = "xiaomi_surya";
};
